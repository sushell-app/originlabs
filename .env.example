# OriginLabs — Variables de entorno (desarrollo / referencia)
ORIGINLABS_DOMAIN=localhost
ORIGINLABS_ENV=development
ORIGINLABS_SECRET_KEY=change-me-in-production-use-32-plus-random-bytes
ORIGINLABS_ENCRYPTION_KEY=change-me-32-byte-encryption-key-for-secrets
ORIGINLABS_BOOTSTRAP_TOKEN=
SESSION_TTL_SECONDS=604800

# PostgreSQL
POSTGRES_DB=originlabs
POSTGRES_USER=originlabs
POSTGRES_PASSWORD=originlabs_dev_password
DATABASE_URL=postgresql+asyncpg://originlabs:originlabs_dev_password@postgres:5432/originlabs

# Redis
REDIS_URL=redis://redis:6379/0

# Caddy Admin API (red interna Docker)
CADDY_ADMIN_URL=http://caddy:2019

# Actualizaciones y notificaciones
ORIGINLABS_RELEASE_CHANNEL=stable
ORIGINLABS_RELEASES_URL=
ORIGINLABS_RELEASES_PUBLIC_KEY=

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
